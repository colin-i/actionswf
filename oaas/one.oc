
format elfobj64

einclude "oaas.h" "oaas.oh"
include "translate.h" "translate.oh"

#multithread unsafe
char openfl_bool=FALSE
char dualmode=FALSE #oaas3 resets this at start, anyway
#

importx "strncmp" strncmp
importx "snprintf" snprintf
importx "strspn" strspn

^import "spcfullafters" spcfullafters 1
^import "spcfull" spcfull 1
import "translated" translated
^import "translate_buffer" translate_buffer
import "untranslated" untranslated

#                     --
#a-cd fg i  -m  - --  vw
#ab-defghijklmnop rst vwx z
#                     VW
#                q   u   y
#also at the end

#a	s [s]
#c	comment
#d	s [s] but diff at format
#f	p/s
#g	like n
#i	string
#m      same like v
#vw	s s
#});	mix indents and in

function translate_one(ss in,ss indents)
	ss oa;set oa spcfull(in)
	sd ?len
	ss ?chr;set chr oa#
	ss cursor;ss o_a;ss pointer;ss ext
	ss buffer;set buffer translate_buffer()
	if chr=(a_low) #class
		ss ?reminder
		set o_a oa
		inc oa
		set oa spcfull(oa)
		if oa#!=(Nullchar)
			set cursor spcfullafters(oa)
			if cursor!=oa
				set ext " extends "
				set pointer spcfull(cursor)
				set reminder cursor#;set cursor# (Nullchar)
			else
				set ext #globalr.blank
				set pointer ext
				set reminder (Nullchar)
			end
			set o_a# (Nullchar)
			set len snprintf(buffer,(a_page_size),"%s%s%s %s%s%s{",indents,in,globalr.class,oa,ext,pointer)
			if len>0
				if len<(a_page_size)
					call translated("Class")
					return buffer
				end
			end
			set o_a# (a_low)
			set cursor# reminder
		end
	elseif chr=(c_low)
		set oa# (Slash)
		set len snprintf(buffer,(a_page_size),"%s%c%s",indents,(Slash),in)
		if len>0
			if len<(a_page_size)
				call translated("Comment")
				return buffer
			end
		end
		set oa# (c_low)
	elseif chr=(d_low)
		set cursor translate_one_add(buffer,indents,in,oa)
		if cursor!=oa
			return cursor
		end
	elseif chr=(func_char)
		set cursor oa
		inc oa
		set oa spcfull(oa)

		whiletrue
			ss type;ss name
			if oa#=(p_low)
				set type globalr.public
				set name globalr.nw
				set ext globalr.super
			elseif oa#=(s_low)
				set type globalr.sttic
				set name "main"
				set ext #globalr.blank
			else
				break
			end
			inc oa
			if oa#=(Nullchar)
				set cursor# (Nullchar)
				set len snprintf(buffer,(a_page_size),"%s%s%s %s %s(){%s",indents,in,type,#globalr.func,name,ext)
				if len>0
					if len<(a_page_size)
						call translated("Function")
						return buffer
					end
				end
				set cursor# (func_char)
			end
			break
		end
	elseif chr=(g_low)
		set cursor translate_one_stage(buffer,indents,in,oa)
		if cursor!=oa
			return cursor
		end
	elseif chr=(i_low) #import
		set o_a oa
		inc oa
		set oa spcfull(oa)
		if oa#!=(Nullchar)
			set pointer #globalr.blank
			if globalr.openfl_bool=(TRUE)
				sd ?c
				char fl="flash."^
				set c strncmp(oa,#fl,\.fl)
				if c=0
					set pointer "openfl."
					add oa \.fl
				end
			end

			set o_a# (Nullchar)
			set len snprintf(buffer,(a_page_size),"%s%simport %s%s;",indents,in,pointer,oa)
			if len>0
				if len<(a_page_size)
					call translated("Import")
					return buffer
				end
			end
			set o_a# (i_low)
		end
	elseif chr=(bitmap_char)
		set cursor translate_one_double(buffer,"%s%s@:bitmap('%s') class %s extends flash.display.BitmapData { }",indents,in,oa,"Bitmap",(bitmap_char))
		if cursor!=oa
			return cursor
		end
	elseif chr=(var_char)
		set cursor translate_one_double(buffer,#globalr.var_translate,indents,in,oa,"Var",(var_char))
		if cursor!=oa
			return cursor
		end
	elseif chr=(nvar_char)
		set cursor translate_one_nvar(buffer,indents,in,oa)
		if cursor!=oa
			return cursor
		end
	elseif chr=(Nullchar)
		call translated("blank")
		return in
	elseif oa#=(Caret)
		set globalr.dualmode (TRUE)
		inc oa
		set len snprintf(buffer,(a_page_size),globalr.double_s,indents,oa)
		if len>=0
			if len<(a_page_size)
				call translated("dual mode")
				return buffer
			end
		end
	else
		set cursor strspn(oa,"});")
		add cursor oa
		if cursor#=(Nullchar)
			set len snprintf(buffer,(a_page_size),globalr.double_s,indents,in)
			if len>0
				if len<(a_page_size)
					call translated("others")
					return buffer
				end
			end
		end
	end
	call untranslated(in)
	return in
end
function translate_one_stage(ss buffer,ss indents,ss in,ss oa)
	ss o_a
	set o_a oa
	inc oa
	if oa#=(Nullchar)
		set o_a# (Nullchar)
		sd ?len
		set len snprintf(buffer,(a_page_size),globalr.triple_s,indents,in,"var stage=flash.Lib.current.stage;")
		if len>0
			if len<(a_page_size)
				call translated("Stage")
				return buffer
			end
		end
		set o_a# (g_low)
	end
	return o_a
end
function translate_one_double(ss buffer,ss format,ss indents,ss in,ss oa,ss onOk,ss ?t)
	ss o_a
	set o_a oa
	inc oa
	set oa spcfull(oa)
	ss cursor
	set cursor spcfullafters(oa)
	if cursor!=oa
		ss pointer
		set pointer spcfull(cursor)
		if pointer!=cursor
			ss ?reminder
			set reminder cursor#;set cursor# (Nullchar)
			set o_a# (Nullchar)
			set pointer translate_leftright(format,indents,in,oa,pointer,buffer) #,#globalr.blank)
			if pointer!=in
				call translated(onOk)
				return pointer
			end
			set o_a# t
			set cursor# reminder
		end
	end
	return o_a
end
function translate_one_add(ss buffer,ss indents,ss in,ss oa)
	ss o_a
	set o_a oa
	inc oa
	set oa spcfull(oa)
	if oa#!=(Nullchar)
		ss cursor;ss ext;ss pointer;ss ?reminder
		set cursor spcfullafters(oa)
		if cursor!=oa
			set pointer spcfull(cursor)
			if pointer#=(Atsymbol)
				inc pointer
				if pointer#!=(Nullchar)
					return o_a
				end
				set pointer globalr.stage
			end
			set reminder cursor#;set cursor# (Nullchar)
			set ext globalr.dot
		else
			set pointer #globalr.blank
			set ext pointer
			set reminder (Nullchar)
		end
		set o_a# (Nullchar)
		sd ?len
		set len snprintf(buffer,(a_page_size),"%s%s%s%saddChild(%s);",indents,in,pointer,ext,oa)
		if len>0
			if len<(a_page_size)
				call translated("AddChild")
				return buffer
			end
		end
		set o_a# (d_low)
		set cursor# reminder
	end
	return o_a
end
function translate_one_nvar(ss buffer,ss indents,ss in,ss oa)
	ss o_a
	set o_a oa
	inc oa
	set oa spcfull(oa)
	ss cursor
	set cursor spcfullafters(oa)
	if cursor!=oa
		ss pointer
		set pointer spcfull(cursor)
		if pointer!=cursor
			ss ?reminder
			set reminder cursor#;set cursor# (Nullchar)
			set o_a# (Nullchar)
			sd ?len
			set len snprintf(buffer,(a_page_size),"%s%svar %s=new %s();%s.name='%s';",indents,in,oa,pointer,oa,oa)
			if len>0
				if len<(a_page_size)
					call translated("VarNamed")
					return buffer
				end
			end
			set o_a# (nvar_char)
			set cursor# reminder
		end
	end
	return o_a
end

function translate_leftright_full(ss format,ss indents,ss in,ss oa,ss pointer,ss out,sd p_len)
	sd ?len
	set len snprintf(out,(a_page_size),format,indents,in,oa,pointer) #,two)
	if len>0
		if len<(a_page_size)
			if p_len!=(NULL)
				set p_len# len
			end
			return out
		end
	end
	return in
end
function translate_leftright(ss format,ss indents,ss in,ss oa,ss pointer,ss out)
	callret translate_leftright_full(format,indents,in,oa,pointer,out,(NULL))
end

function openfl()
	return #globalr.openfl_bool
end
function dual_mode()
	return #globalr.dualmode
end

entryraw globalr()

#!
rtu
s

AddChild
Alpha
ArrayConstructor
Bitmap
BitmapMorph
blank
ButtonMode
ChildByName
ChildCast
